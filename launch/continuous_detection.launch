<launch>
  <arg name="launch_prefix" default="" /> <!-- set to value="gdbserver localhost:10000" for remote debugging -->
  <arg name="node_namespace" default="apriltag_ros_continuous_node" />
  <arg name="camera_name" default="/uav_1/usb_cam" />
  <arg name="image_topic" default="image_raw" />
  <arg name="camera_info_topic" default="camera_info" />
  <arg name="image_transport" default="raw" />

  <!-- Set parameters -->
  <rosparam command="load" file="$(find lite_quad_uav)/config/settings.yaml" ns="$(arg node_namespace)" />
  <rosparam command="load" file="$(find lite_quad_uav)/config/tags.yaml" ns="$(arg node_namespace)" />
  
  <node pkg="apriltag_ros" type="apriltag_ros_continuous_node" name="$(arg node_namespace)" clear_params="true" output="screen" launch-prefix="$(arg launch_prefix)" >
    <!-- Remap topics from those used in code to those on the ROS network -->
    <!--
      image_transport controls the actual subscribed image transport:
        image_transport:=raw        -> /uav_1/usb_cam/image_raw
        image_transport:=compressed -> /uav_1/usb_cam/image_raw/compressed
    -->
    <remap from="image_rect" to="$(arg camera_name)/$(arg image_topic)" />
    <remap from="camera_info" to="$(arg camera_name)/$(arg camera_info_topic)" />

    <param name="transport_hint" type="str" value="$(arg image_transport)" />
    <param name="publish_tag_detections_image" type="bool" value="true" />      <!-- default: false -->
  </node>
</launch>
