<?xml version="1.0"?>
<package format="2">
  <name>lite_quad_uav</name>
  <version>0.1.0</version>
  <description>ROS1 Noetic + MAVROS + PX4 SITL UAV control framework</description>

  <maintainer email="854459949@qq.com">ATRI</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>apriltag_ros</depend>
  <depend>mavros_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
